{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>renovate-presets",
    ":pinAllExceptPeerDependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MODULE.bazel$/"
      ],
      "matchStrings": [
        "#\\s*renovate-handled:\\s+pull\\(\\s*name = \"(?<nameAttr>[^\"]+)\",\\s*digest = \"(?<currentDigest>sha256:[a-f0-9]+)\",\\s*registry = \"(?<registry>[^\"]+)\",\\s*repository = \"(?<repositoryAttr>[^\"]+)\",\\s*tag = \"(?<currentValue>[^\"]+)\",\\s*\\)"
      ],
      "depNameTemplate": "{{{repositoryAttr}}}/{{{nameAttr}}}",
      "versioningTemplate": "docker",
      "datasourceTemplate": "docker"
    }
  ],
  "ignorePaths": [
    "websites/sites/archive.avm99963.com/src/**"
  ],
  "postUpgradeTasks": {
    "commands": [
      "bazel mod deps --lockfile_mode=update",
      "bazel mod tidy",
      "bazel run //tools:preset.update"
    ],
    "fileFilters": ["MODULE.bazel.lock", "tools/preset.bazelrc"],
    "executionMode": "branch"
  }
}
