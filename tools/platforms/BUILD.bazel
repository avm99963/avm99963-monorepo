# These platforms are mainly used for building OCI images.
# Read https://github.com/bazel-contrib/rules_img/blob/main/docs/platforms.md

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_arm_v7",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",
    ],
    visibility = ["//:__subpackages__"],
)
